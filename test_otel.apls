#!/usr/local/bin/dyalogscript
⍝ Integration test for dyalog-otel
⍝ Tests DWA exports end-to-end: init → signals → flush → content verification → shutdown
⍝
⍝ Usage:  .\run_apl.ps1 test_otel.apls

⎕IO←0 ⋄ ⎕ML←1

dll←'##DLLPATH##'

pass←0 ⋄ fail←0
check←{(name exp got)←⍵ ⋄ exp≡got:⊢(pass+←1)⊢⎕←'  ✓ ',name ⋄ ⊢(fail+←1)⊢⎕←'  ✗ ',name,' — exp ',(⍕exp),' got ',⍕got}

⍝ Clean up any leftover test output (1= wildcard/no-error-if-missing)
_←1 ⎕NDELETE 'test-output.jsonl'

⎕←'=== dyalog-otel Integration Tests ==='

⍝ --- Version ---
⎕←'Version:'
⎕NA dll,'|pp_otel_version >PP'
ver←pp_otel_version 0
_←check 'version is string' 1 (0<≢ver)
_←check 'version content' 1 (∨/'0.1.0'⍷ver)

⍝ --- Init (uses test_otel.ini via DYALOG_OTEL_CONFIG env var) ---
⎕←'Init:'
⎕NA dll,'|pp_otel_init >PP'
h←pp_otel_init 0
_←check 'init returns 0' 0 h

⍝ --- Status ---
⎕←'Status:'
⎕NA dll,'|pp_otel_status I4 >PP'
st←pp_otel_status 0 0
_←check 'status is healthy' 0 st

⍝ --- Log (plain text, no template, no attrs) ---
⎕←'Log:'
⎕NA dll,'|pp_otel_log I4 I4 <PP <PP <PP'
pp_otel_log 0 9 'Hello from APL' '' ⍬
_←check 'log plain (no error)' 1 1

⍝ --- Log with placeholder-looking body but no fillers ---
pp_otel_log 0 9 'Raw {Name}' '' ⍬
_←check 'log raw placeholder (no error)' 1 1

⍝ --- Log with message template ---
⎕←'Log with template:'
pp_otel_log 0 9 'Order {OrderId} placed for {Amount}' '' (42 99.5)
_←check 'log template (no error)' 1 1

⍝ --- Log with key-value attributes ---
pp_otel_log 0 9 'Event with attrs' '' ('user' 'alice')
_←check 'log attrs (no error)' 1 1

⍝ --- Span start/end ---
⎕←'Span:'
⎕NA dll,'|pp_otel_span_start I4 <PP I4 <PP <PP >PP'
⎕NA dll,'|pp_otel_span_end I4 I4 <PP <PP'
sh←pp_otel_span_start 0 'test-operation' 0 '' ⍬ 0
_←check 'span handle > 0' 1 (sh>0)
pp_otel_span_end 0 sh '' ⍬
_←check 'span end (no error)' 1 1

⍝ --- Log correlated with span ---
⎕←'Log + Span correlation:'
⎕NA dll,'|pp_otel_log_span I4 I4 <PP I4 <PP <PP'
sh2←pp_otel_span_start 0 'parent-op' 0 '' ⍬ 0
pp_otel_log_span 0 9 'Event inside span' sh2 '' ⍬
_←check 'log_span (no error)' 1 1
pp_otel_span_end 0 sh2 '' ⍬

⍝ --- Nested spans ---
⎕←'Nested spans:'
root←pp_otel_span_start 0 'root' 0 '' ⍬ 0
child←pp_otel_span_start 0 'child' root '' ⍬ 0
_←check 'child handle ≠ root' 1 (child≠root)
pp_otel_span_end 0 child '' ⍬
pp_otel_span_end 0 root '' ⍬
_←check 'nested spans (no error)' 1 1

⍝ --- Metric ---
⎕←'Metric:'
⎕NA dll,'|pp_otel_metric I4 <PP <PP I4 <PP <PP'
pp_otel_metric 0 'requests.count' (,1) 0 '' ⍬
_←check 'counter (no error)' 1 1
pp_otel_metric 0 'cpu.usage' (,72.5) 1 '' ⍬
_←check 'gauge (no error)' 1 1
pp_otel_metric 0 'request.duration' (,150.3) 2 '' ⍬
_←check 'histogram (no error)' 1 1

⍝ --- Stats ---
⎕←'Stats:'
⎕NA dll,'|pp_otel_stats I4 >PP'
raw←pp_otel_stats 0 0
_←check 'stats is 9-element' 9 (≢raw)
stats←3 3⍴raw
_←check 'logs enqueued > 0' 1 (0<stats[0;0])
_←check 'spans enqueued > 0' 1 (0<stats[1;0])
_←check 'metrics enqueued > 0' 1 (0<stats[2;0])
⎕←'  Stats matrix (log/span/metric × enq/exp/drop):'
⎕←stats

⍝ --- Template create ---
⎕←'Templates:'
⎕NA dll,'|pp_otel_tpl_create I4 <PP <PP'
pp_otel_tpl_create 0 'base' ('service' 'OrderService' 'version' '1.0')
_←check 'tpl create (no error)' 1 1

⍝ --- Log with template name ---
pp_otel_log 0 9 'Using template' 'base' ⍬
_←check 'log with tpl name (no error)' 1 1

⍝ --- Template delete ---
⎕NA dll,'|pp_otel_tpl_delete I4 <PP'
pp_otel_tpl_delete 0 'base'
_←check 'tpl delete (no error)' 1 1

⍝ --- Flush ---
⎕←'Flush:'
⎕NA dll,'|pp_otel_flush I4'
pp_otel_flush 0
_←check 'flush (no error)' 1 1

⍝ Check stats after flush
raw2←pp_otel_stats 0 0
stats2←3 3⍴raw2
⎕←'  Stats after flush:'
⎕←stats2
_←check 'logs exported after flush' 1 (0<stats2[0;1])

⍝ ═══════════════════════════════════════════════════
⍝ CONTENT VERIFICATION — read and check JSONL output
⍝ ═══════════════════════════════════════════════════
⎕←''
⎕←'Content verification (JSONL file):'

:If ⎕NEXISTS 'test-output.jsonl'
    _←check 'jsonl file exists' 1 1

    ⍝ Read all lines
    rawlines←⊃⎕NGET 'test-output.jsonl' 1
    lines←(0<≢¨rawlines)/rawlines
    _←check 'jsonl has lines' 1 (0<≢lines)

    ⍝ Parse each line as JSON → vector of namespaces
    records←⎕JSON¨ lines
    ⎕←'  Total records: ',⍕≢records

    ⍝ Classify by type-discriminating fields (⊃ needed: ⎕NC always returns a vector)
    isLog←{0≠⊃⍵.⎕NC'severityNumber'}¨records
    isSpan←{(0≠⊃⍵.⎕NC'startTimeUnixNano')∧0≠⊃⍵.⎕NC'endTimeUnixNano'}¨records
    isMetric←(~isLog)∧(~isSpan)

    logs←isLog/records
    spans←isSpan/records
    metrics←isMetric/records
    ⎕←'  Logs: ',(⍕≢logs),'  Spans: ',(⍕≢spans),'  Metrics: ',⍕≢metrics

    ⍝ ── Log content ──
    _←check 'file: 6 log records' 6 (≢logs)

    :If 6≤≢logs
        _←check 'log[0] body' 'Hello from APL' (0⊃logs).body
        _←check 'log[0] severity' 'INFO' (0⊃logs).severityText
        _←check 'log[0] timestamp > 0' 1 (0<(0⊃logs).timestampUnixNano)

        _←check 'log[1] body raw placeholder' 'Raw {Name}' (1⊃logs).body

        ⍝ Template-rendered body should contain the filler values
        _←check 'log[2] body has "42"' 1 (∨/'42'⍷(2⊃logs).body)
        _←check 'log[2] body has "99"' 1 (∨/'99'⍷(2⊃logs).body)

        _←check 'log[3] attr key' 'user' (0⊃(3⊃logs).attributes).key
        _←check 'log[3] attr value' 'alice' (0⊃(3⊃logs).attributes).value

        ⍝ Span-correlated log should have trace context
        _←check 'log[4] body' 'Event inside span' (4⊃logs).body
        _←check 'log[4] has traceId' 1 (0<≢(4⊃logs).traceId)
        _←check 'log[4] has spanId' 1 (0<≢(4⊃logs).spanId)

        _←check 'log[5] body' 'Using template' (5⊃logs).body
    :EndIf

    ⍝ ── Span content ──
    _←check 'file: 4 span records' 4 (≢spans)

    :If 4≤≢spans
        _←check 'span[0] name' 'test-operation' (0⊃spans).name
        _←check 'span[0] has traceId' 1 (0<≢(0⊃spans).traceId)
        _←check 'span[0] has spanId' 1 (0<≢(0⊃spans).spanId)
        _←check 'span[0] duration > 0' 1 ((0⊃spans).endTimeUnixNano>(0⊃spans).startTimeUnixNano)

        ⍝ Child span should have parent
        _←check 'span[2] name' 'child' (2⊃spans).name
        _←check 'span[2] has parentSpanId' 1 (0<≢(2⊃spans).parentSpanId)

        _←check 'span[3] name' 'root' (3⊃spans).name
    :EndIf

    ⍝ ── Metric content ──
    _←check 'file: 3 metric records' 3 (≢metrics)

    :If 3≤≢metrics
        _←check 'metric[0] name' 'requests.count' (0⊃metrics).name
        _←check 'metric[0] value' 1 (0⊃metrics).value
        _←check 'metric[0] type (counter=0)' 0 (0⊃metrics).type

        _←check 'metric[1] name' 'cpu.usage' (1⊃metrics).name
        _←check 'metric[1] value' 72.5 (1⊃metrics).value
        _←check 'metric[1] type (gauge=1)' 1 (1⊃metrics).type

        _←check 'metric[2] name' 'request.duration' (2⊃metrics).name
        _←check 'metric[2] value' 150.3 (2⊃metrics).value
        _←check 'metric[2] type (histogram=2)' 2 (2⊃metrics).type
    :EndIf
:Else
    _←check 'jsonl file exists' 1 0
:EndIf

⍝ --- Shutdown ---
⎕←''
⎕←'Shutdown:'
⎕NA dll,'|pp_otel_shutdown I4'
pp_otel_shutdown 0
_←check 'shutdown (no error)' 1 1

⎕←''
⎕←'=== Results: ',(⍕pass),' passed, ',(⍕fail),' failed ==='
⎕OFF fail>0
