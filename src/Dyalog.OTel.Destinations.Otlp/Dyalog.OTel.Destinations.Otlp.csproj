<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>NativeAOT companion DLL for OTLP destinations</Description>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dyalog.OTel.Abstractions\Dyalog.OTel.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Dyalog.OTel.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LightProto" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Dyalog.OTel\Destinations\OtlpJsonDestination.cs" Link="Destinations\OtlpJsonDestination.cs" />
    <Compile Include="..\Dyalog.OTel\Destinations\OtlpProtobufDestination.cs" Link="Destinations\OtlpProtobufDestination.cs" />
    <Compile Include="..\Dyalog.OTel\Serialization\JsonModels\OtlpModels.cs" Link="Serialization\JsonModels\OtlpModels.cs" />
    <Compile Include="..\Dyalog.OTel\Serialization\JsonModels\OtlpJsonContext.cs" Link="Serialization\JsonModels\OtlpJsonContext.cs" />
    <Compile Include="..\Dyalog.OTel\Serialization\ProtoModels\OtlpProtoModels.cs" Link="Serialization\ProtoModels\OtlpProtoModels.cs" />
  </ItemGroup>
</Project>
